{
    "name": "sdpayhub/laravel-payzy",
    "description": "Enterprise-grade Laravel payment package with a unified API for Razorpay, Stripe, PayPal, Paytm, and PhonePe.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "payzy",
        "sdpayhub",
        "payments",
        "razorpay",
        "stripe",
        "paypal",
        "paytm",
        "phonepe",
        "payment-gateway",
        "webhooks",
        "idempotency"
    ],
    "authors": [
        {
            "name": "Deepak Shukla",
            "email": "dshukla0806@gmail.com",
            "homepage": "https://github.com/shukladeepak08",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/shukladeepak08/sdpayhub-laravel-payzy",
    "support": {
        "issues": "https://github.com/shukladeepak08/sdpayhub-laravel-payzy/issues",
        "source": "https://github.com/shukladeepak08/sdpayhub-laravel-payzy",
        "docs": "https://github.com/shukladeepak08/sdpayhub-laravel-payzy#readme",
        "security": "https://github.com/shukladeepak08/sdpayhub-laravel-payzy/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/log": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1|^2.0",
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "ergebnis/composer-normalize": "^2.42"
    },
    "autoload": {
        "psr-4": {
            "Sdpayhub\\Payzy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sdpayhub\\Payzy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sdpayhub\\Payzy\\Providers\\PayzyServiceProvider"
            ],
            "aliases": {
                "Payzy": "Sdpayhub\\Payzy\\Facades\\Payzy"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=95",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "format": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "ergebnis/composer-normalize": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
